# Safe configuration template only. Never put real passwords or API keys here.
# Copy this file to .env and place personal development secrets in .env.

# Local PostgreSQL development settings
POSTGRES_DB=unshaken_smart_coach
POSTGRES_USER=unshaken
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432
EXERCISE_DB_BASE_URL=https://exercisedb.p.rapidapi.com
EXERCISE_DB_HOST=exercisedb.p.rapidapi.com
# Keep this placeholder in .env.example; replace it only in your local .env.
EXERCISE_DB_API_KEY=<<YOUR_EXERCISE_DB_API_KEY>>
EXERCISE_DB_MEDIA_ENABLED=true
DATABASE_URL=<<YOUR_DATABASE_URL>>
FRONTEND_API_BASE_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
DEVELOPMENT_USER_ID=00000000-0000-4000-8000-000000000001
DEVELOPMENT_USER_EMAIL=<<YOUR_DEVELOPMENT_USER_EMAIL>>
DEVELOPMENT_USER_DISPLAY_NAME=Local User
